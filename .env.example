# QuietBoard – Konfiguration. Kopieren nach .env; Secrets erzeugt ./generate-env.sh.
# ---------------------------------------------------------------- Pflicht
# Admin-Konto für Healthchecks und Beszel (Login) und Ziel für Alarm-Mails
ADMIN_EMAIL=
# Zeitzone und Name für Morgenmeldung und Oberfläche
TZ=Europe/Berlin
SITE_NAME=Homelab
# Öffentliche Adressen (so, wie Browser bzw. Hosts sie erreichen). Leer lassen:
# generate-env.sh setzt dann http://<erste IP dieses Servers>:8000 bzw. :8090 (oder PUBLIC_HOST=…).
HC_PUBLIC_URL=
HC_PING_ENDPOINT=
BESZEL_PUBLIC_URL=

# ---------------------------------------------------------------- Secrets (./generate-env.sh)
ADMIN_PASSWORD=
HC_SECRET_KEY=
INGEST_TOKEN=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------- Optional
# Nur an diese Adresse binden (z. B. 127.0.0.1 oder die VPN-Adresse)
#BIND_ADDR=0.0.0.0
# Weitere Namen/IPs, unter denen Healthchecks erreichbar sein soll (Komma-getrennt)
#HC_EXTRA_HOSTS=
# Bestehende Healthchecks/Beszel statt Selbsteinrichtung (sonst leer lassen)
#HC_API_KEY=
#HC_PING_KEY=
#BESZEL_APP_USER=
#BESZEL_APP_PASS=
# Version der App: latest (neueste stabile), v0 / v0.1 / v0.1.0 zum Festhalten, edge = Entwicklungsstand
#QB_VERSION=latest
# Ganz anderes Image (z. B. lokal gebaut)
#STATUS_IMAGE=
# Mail (Healthchecks)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_TLS=True
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#VAPID_SUBJECT=mailto:admin@example.org
# Anmeldung: bis lokale Konten fertig sind, nur über Cloudflare Access (Profil tunnel)
#ACCESS_TEAM=
#ACCESS_AUD=
# Reverse-Proxy vor der App (Name des Containers oder Netz); Standard: cloudflared aus dem Profil tunnel
#TRUSTED_PROXIES=cloudflared
#TUNNEL_TOKEN=
# NUR für Tests im eigenen Netz: App ohne Anmeldung
#ALLOW_NO_AUTH=0
# Beispieldaten statt Motoren
#DEMO=false
# PBS (Read-only-Tokens):  name|url|tokenid|secret|fingerprint ; mehrere getrennt durch ; (Fingerprint: PBS-Dashboard)
#PBS_TARGETS=
# Signal (Profil signal)
#SIGNAL_NUMBER=
#SIGNAL_RECIPIENT=
